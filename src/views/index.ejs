<%- include('partials/head', { pageTitle: 'SourCode, the sweet shop', q, user }) %>

    <% if (error) { %>
      <div class="err">Database error: <%= error %></div>
    <% } %>

    <% if (results) { %>
      <div class="results">
        <h2><%= results.length %> result<%= results.length === 1 ? '' : 's' %> for &ldquo;<%- qEcho %>&rdquo;</h2>
        <% if (results.length) { %>
          <table>
            <thead><tr><% Object.keys(results[0]).forEach(function(k){ %><th><%= k %></th><% }) %></tr></thead>
            <tbody>
              <% results.forEach(function(row){ %>
                <tr><% Object.values(row).forEach(function(v){ %><td><%= v %></td><% }) %></tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p>Nothing matched. Try another search.</p>
        <% } %>
      </div>
    <% } %>

    <h1>The Sweet Counter</h1>
    <p class="sub">Everything in jars, nothing behind glass. Have a browse.</p>
    <div class="grid">
      <% sweets.forEach(function(s){ %>
        <div class="sweet">
          <a href="/sweet/<%= s.id %>" class="sweet-img" style="text-decoration:none"><%- art(s.name, s.category) %></a>
          <div class="sweet-in">
            <span class="cat"><%= s.category %></span>
            <h3><a href="/sweet/<%= s.id %>" style="color:inherit;text-decoration:none"><%= s.name %></a></h3>
            <p><%= s.description %></p>
            <div class="sweet-foot">
              <span class="price">£<%= (s.price_pence/100).toFixed(2) %></span>
              <form action="/cart/add" method="post">
                <input type="hidden" name="sweet_id" value="<%= s.id %>" />
                <input type="hidden" name="price" value="<%= s.price_pence %>" />
                <button class="btn" type="submit">Add</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

<%- include('partials/foot') %>
